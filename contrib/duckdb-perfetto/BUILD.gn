declare_args() {
  # A (sparse) checkout of the DuckDB source tree matching the DuckDB version
  # the extension will be loaded into. Fetched by build.sh.
  duckdb_source_dir = "third_party/duckdb"
}

group("root") {
  testonly = true
  deps = [
    ":perfetto_duckdb",
    ":perfetto_duckdb_unittests",
  ]
}

# DuckDB's internal C++ headers. Included as system headers so that their
# warnings don't drown ours.
config("duckdb_headers") {
  _dirs = [
    "src/include",
    "third_party/fmt/include",
    "third_party/fsst",
    "third_party/re2",
    "third_party/utf8proc/include",
    "third_party/yyjson/include",
  ]
  cflags = []
  foreach(d, _dirs) {
    cflags += [
      "-isystem",
      rebase_path("$duckdb_source_dir/$d", root_build_dir),
    ]
  }
  defines = [ "DUCKDB_BUILD_LOADABLE_EXTENSION" ]
}

# DuckDB's C++ API requires exceptions and RTTI, and the classes we derive
# from must keep default visibility for exceptions and dynamic casts to work
# across the extension/host boundary.
config("duckdb_cxx") {
  cflags_cc = [
    "-fexceptions",
    "-frtti",
  ]
}

# The PERFETTO(...) ( ... ) block rewriter. Uses syntaqlite (TraceProcessor's
# SQL front end) for the PerfettoSQL inside blocks; no DuckDB dependency.
source_set("block_rewriter") {
  sources = [
    "src/block_rewriter.cc",
    "src/block_rewriter.h",
  ]
  deps = [
    "../../gn:default_deps",
    "../../include/perfetto/ext/base",
    "../../src/base",
    "../../src/perfetto_sql/syntaqlite",
  ]
}

# Everything that talks to TraceProcessor. No DuckDB dependency, built with
# Perfetto's usual flags.
source_set("trace_session") {
  sources = [
    "src/trace_session.cc",
    "src/trace_session.h",
  ]
  public_deps = [
    "../../include/perfetto/base",
    "../../include/perfetto/ext/base",
    "../../include/perfetto/trace_processor",
  ]
  deps = [
    "../../gn:default_deps",
    "../../src/trace_processor:lib",
  ]
}

# The only code which includes DuckDB headers.
source_set("duckdb_glue") {
  sources = [ "src/perfetto_extension.cc" ]

  # These must match the labels in default_configs exactly, so they can't be
  # relative.
  configs -= [
    "//gn/standalone:no_exceptions",  # nogncheck
    "//gn/standalone:rtti_cflags",  # nogncheck
    "//gn/standalone:visibility_hidden",  # nogncheck
  ]
  configs += [
    ":duckdb_headers",
    ":duckdb_cxx",
  ]
  deps = [
    ":block_rewriter",
    ":trace_session",
    "../../gn:default_deps",
  ]
}

# The raw shared library. build.sh appends the DuckDB extension metadata
# footer to produce perfetto.duckdb_extension. DuckDB symbols are resolved
# against the host process at load time.
shared_library("perfetto_duckdb") {
  deps = [
    ":duckdb_glue",
    "../../gn:default_deps",
  ]
  if (is_mac) {
    ldflags = [ "-Wl,-undefined,dynamic_lookup" ]
  }
}

executable("perfetto_duckdb_unittests") {
  testonly = true
  sources = [ "src/block_rewriter_unittest.cc" ]
  deps = [
    ":block_rewriter",
    "../../gn:default_deps",
    "../../gn:gtest_and_gmock",
    "../../gn:gtest_main",
    "../../src/perfetto_sql/syntaqlite",
  ]
}
