# Alternative GN dotfile which reuses the standalone Perfetto toolchain but
# roots the build graph at this directory. This keeps contrib/ fully decoupled
# from the root BUILD.gn. Use via:
#   tools/gn gen out/duckdb --root=. --dotfile=contrib/duckdb-perfetto/.gn
buildconfig = "//gn/standalone/BUILDCONFIG.gn"
root = "//contrib/duckdb-perfetto:root"
script_executable = "python3"

default_args = {
  # DuckDB runs TraceProcessor instances on several worker threads at once
  # (e.g. one per trace for bulk queries), which SQLite's default
  # single-thread mode does not allow.
  perfetto_sqlite_threadsafe = 2
}
