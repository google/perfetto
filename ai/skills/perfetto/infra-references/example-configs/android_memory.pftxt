# Android memory in a system trace: every signal that
# workflows/android_memory/system_trace_memory.md reads. Per-process RSS, swap
# and OOM score (polled and on change), device meminfo/vmstat/PSI, Java heap
# and GC (atrace dalvik), bitmaps and gralloc buffers (gfx), HWUI/Skia caches
# (view), binder proxies (aidl), process-state reasons (am), GPU memory,
# DMA-BUF heap and per-process DMA-BUF RSS, and low-memory kills.
# Raise duration_ms to cover the whole scenario.
buffers {
  size_kb: 65536
  fill_policy: RING_BUFFER
}
duration_ms: 30000

data_sources {
  config {
    name: "linux.process_stats"
    process_stats_config {
      scan_all_processes_on_start: true
      proc_stats_poll_ms: 1000
      record_process_dmabuf_rss: true
    }
  }
}

data_sources {
  config {
    name: "linux.sys_stats"
    sys_stats_config {
      # No counter lists: all meminfo and vmstat counters are reported.
      meminfo_period_ms: 1000
      vmstat_period_ms: 1000
      psi_period_ms: 1000
    }
  }
}

data_sources {
  config {
    name: "android.gpu.memory"
  }
}

data_sources {
  config {
    name: "linux.ftrace"
    ftrace_config {
      # Process lifetimes and names (restarts, short-lived forks).
      ftrace_events: "sched/sched_process_exit"
      ftrace_events: "sched/sched_process_free"
      ftrace_events: "task/task_newtask"
      ftrace_events: "task/task_rename"
      # Memory events.
      ftrace_events: "kmem/rss_stat"
      ftrace_events: "kmem/dmabuf_rss_stat"
      ftrace_events: "oom/oom_score_adj_update"
      ftrace_events: "dmabuf_heap/dma_heap_stat"
      ftrace_events: "gpu_mem/gpu_mem_total"
      ftrace_events: "lowmemorykiller/lowmemory_kill"
      throttle_rss_stat: true
      atrace_categories: "dalvik"
      atrace_categories: "gfx"
      atrace_categories: "view"
      atrace_categories: "aidl"
      atrace_categories: "am"
      atrace_apps: "lmkd"
    }
  }
}
