packet {
  trusted_packet_sequence_id: 999
  timestamp: 10
  # A heap exercising the field trees. Sizes are powers of two so that every
  # aggregate is unambiguous.
  #
  #   R[1] --.head--> Node[2] --.next--> Node[4] --.next--> Node[8]
  #     |--.items---> Object[][16] --> X[32]
  #     |                          \-> X[64]
  #     |--.left----> P[128] --.value--\
  #     \--.right---> Q[256] --.value---> V[512]
  #
  # - The linked list collapses into one `.next -> Node` level.
  # - Array elements have no field frame.
  # - V is reachable from both P and Q, so R is its immediate dominator but
  #   does not reference it: in the dominator field tree its frame is
  #   '[via P.value]', the field which holds it on the shortest path.
  [com.android.art.tracing.ArtHeapGraphTracePacket.heap_graph] {
    pid: 2
    roots {
      root_type: ROOT_JNI_GLOBAL
      object_ids: 0x1
    }
