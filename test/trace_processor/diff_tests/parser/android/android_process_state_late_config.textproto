# The trace_config packet is not guaranteed to sort first: here it carries a
# timestamp at the end of the trace. Config detection must still happen before
# any process event is parsed, otherwise the framework would not be treated as
# the process authority and the two incarnations of pid 100 would be merged
# into a single process.
packet {
  clock_snapshot {
    primary_trace_clock: BUILTIN_CLOCK_BOOTTIME
    clocks { clock_id: 6 timestamp: 0 }
    clocks { clock_id: 3 timestamp: 0 }
  }
  trusted_uid: 9999
  trusted_packet_sequence_id: 1
}
# App A starts on pid 100 (seq_id: 1).
packet {
  timestamp: 1000000000
  trusted_packet_sequence_id: 1
  track_event {
    type: TYPE_INSTANT
    name: "process_start"
    [com.android.internal.FrameworksBaseTrackEvent.process_start_event] {
      uid: 10001
      pid: 100
      process_name: "com.example.appa"
      start_seq_id: 1
    }
  }
}
# pid 100 is recycled by App B (seq_id: 2).
packet {
  timestamp: 5000000000
  trusted_packet_sequence_id: 1
  track_event {
    type: TYPE_INSTANT
    name: "process_start"
    [com.android.internal.FrameworksBaseTrackEvent.process_start_event] {
      uid: 10002
      pid: 100
      process_name: "com.example.appb"
      start_seq_id: 2
    }
  }
}
# The config sorts after everything else.
packet {
  timestamp: 9000000000
  trace_config {
    data_sources {
      config {
        name: "android.process_state"
        android_process_state_config {
          dump_process_metadata: true
        }
      }
    }
  }
}
