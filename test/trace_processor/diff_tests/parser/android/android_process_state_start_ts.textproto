# Exercises proc_state_start_ns / prev_proc_state_start_ns bounding of initial
# process states:
# - PID 100: in dump only, with proc_state_start_ns (500) earlier than first packet (1000).
# - PID 200: has deltas with prev_proc_state_start_ns (800) on earliest delta, and dump with
#            proc_state_start_ns (3000). The earliest delta's start (800) must win.
# - PID 300: has deltas without prev_proc_state_start_ns, and dump has proc_state_start_ns (2000).
#            state_start_ts must remain NULL (never fall back to dump's end-state start).
# - PID 400: in dump only, without proc_state_start_ns. state_start_ts remains NULL.

packet {
  timestamp: 1000
  process_tree {
    processes { pid: 100 ppid: 1 cmdline: "proc100" }
    processes { pid: 200 ppid: 1 cmdline: "proc200" }
    processes { pid: 300 ppid: 1 cmdline: "proc300" }
    processes { pid: 400 ppid: 1 cmdline: "proc400" }
  }
}
packet {
  timestamp: 1000
  track_descriptor {
    uuid: 2
    thread {
      pid: 200
      tid: 200
      thread_name: "main"
    }
  }
}
packet {
  timestamp: 1000
  track_descriptor {
    uuid: 3
    thread {
      pid: 300
      tid: 300
      thread_name: "main"
    }
  }
}
# Track event for PID 200: first state change at 2000.
packet {
  timestamp: 2000
  trusted_packet_sequence_id: 1
  track_event {
    type: TYPE_INSTANT
    track_uuid: 2
    name: "proc_state_change"
    [com.android.internal.FrameworksBaseTrackEvent.process_state_changed_event] {
      pid: 200
      uid: 10002
      prev_proc_state: PROCESS_STATE_TOP
      cur_proc_state: PROCESS_STATE_IMPORTANT_FOREGROUND
      prev_proc_state_start_ns: 800
      reason: 3
      seq_id: 10
    }
  }
}
# Track event for PID 200: second state change at 3000.
packet {
  timestamp: 3000
  trusted_packet_sequence_id: 1
  track_event {
    type: TYPE_INSTANT
    track_uuid: 2
    name: "proc_state_change"
    [com.android.internal.FrameworksBaseTrackEvent.process_state_changed_event] {
      pid: 200
      uid: 10002
      prev_proc_state: PROCESS_STATE_IMPORTANT_FOREGROUND
      cur_proc_state: PROCESS_STATE_CACHED_ACTIVITY
      prev_proc_state_start_ns: 2000
      reason: 4
      seq_id: 11
    }
  }
}
# Track event for PID 300: state change at 2000 without prev_proc_state_start_ns.
packet {
  timestamp: 2000
  trusted_packet_sequence_id: 1
  track_event {
    type: TYPE_INSTANT
    track_uuid: 3
    name: "proc_state_change"
    [com.android.internal.FrameworksBaseTrackEvent.process_state_changed_event] {
      pid: 300
      uid: 10003
      prev_proc_state: PROCESS_STATE_TOP
      cur_proc_state: PROCESS_STATE_IMPORTANT_FOREGROUND
      reason: 3
      seq_id: 20
    }
  }
}
# Trace-stop dump for process state.
packet {
  timestamp: 10000
  [com.android.internal.FrameworksBaseTracePacket.android_process_state] {
    record {
      pid: 100
      uid: 10001
      proc_state: 1002
      proc_state_start_ns: 500
    }
    record {
      pid: 200
      uid: 10002
      proc_state: 1015
      proc_state_start_ns: 3000
    }
    record {
      pid: 300
      uid: 10003
      proc_state: 1005
      proc_state_start_ns: 2000
    }
    record {
      pid: 400
      uid: 10004
      proc_state: 1003
    }
  }
}
