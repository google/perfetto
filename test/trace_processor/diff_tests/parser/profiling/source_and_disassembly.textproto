# Bundled source and disassembly packets.
packet {
  source_file {
    path: "f2.cc"
    contents: "int f2() {\n  return 2;\n}\n"
  }
}
packet {
  module_disassembly {
    path: "/liblib.so"
    build_id: "build-id"
    source_files: "f2.cc"
    functions {
      name: "f2"
      start_address: 0x2000
      size: 8
      instructions {
        address: 0x2000
        bytes: "\x55"
        text: "push rbp"
        source_file_index: 0
        line_number: 1
      }
      instructions {
        address: 0x2001
        bytes: "\xeb\xfd"
        text: "jmp 0x2000"
        target_address: 0x2000
        source_file_index: 0
        line_number: 2
      }
      instructions {
        address: 0x2003
        bytes: "\xe8\x00\x00\x00\x00"
        text: "call 0x3000"
        target_address: 0x3000
        target_symbol: "f3"
      }
    }
  }
}
# Disassembly for a module which does not appear in the trace is dropped.
packet {
  module_disassembly {
    path: "/libmissing.so"
    build_id: "missing"
    functions {
      name: "missing"
      start_address: 0x10
      size: 1
      instructions {
        address: 0x10
        bytes: "\xc3"
        text: "ret"
      }
    }
  }
}
