      "id": "preset:app_startup_latency",
      "category": "App Performance",
      "name": "Application Startup Latency",
      "description": "Measures activity resume and application bind duration",
      "perfettoSql": "SELECT name, dur / 1e6 AS dur_ms, ts FROM slice WHERE name GLOB '*activity*' OR name GLOB '*bindApplication*' ORDER BY dur DESC;",
      "icon": "speed"
    },
    {
      "id": "preset:top_slices_by_duration",
      "category": "Slices",
      "name": "Top Slices by Total Duration",
      "description": "Aggregates slices by name and sums their duration",
      "perfettoSql": "SELECT name, count(1) AS count, sum(dur) / 1e6 AS total_dur_ms, avg(dur) / 1e6 AS avg_dur_ms FROM slice GROUP BY name ORDER BY total_dur_ms DESC LIMIT 50;",
      "icon": "analytics"
    },
    {
      "id": "preset:binder_transactions",
      "category": "IPC",
      "name": "Binder Transactions (>2ms)",
      "description": "Binder transactions taking longer than 2ms",
      "perfettoSql": "SELECT name, dur / 1e6 AS dur_ms FROM slice WHERE name GLOB '*binder*' AND dur > 2000000 ORDER BY dur DESC;",
      "icon": "sync_alt"
    }
