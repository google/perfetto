import("../../../gn/perfetto.gni")

source_set("unwind_core") {
  public_deps = [ "../../base" ]
  deps = [ "../../../gn:default_deps" ]
  sources = [
    "cpu_registers.h",
    "get_asm_regs.h",
    "unwind_engine.cc",
    "unwind_engine.h",
    "unwind_types.h",
  ]
}

if (enable_perfetto_benchmarks) {
  source_set("benchmarks") {
    testonly = true
    deps = [
      ":unwind_core",
      "../../../gn:benchmark",
      "../../../gn:default_deps",
      "../../../src/base",
      "../perf:unwinding",
      "libunwindstack",
    ]
    sources = [ "unwind_benchmark.cc" ]
  }
}
