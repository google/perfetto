import("../../../gn/perfetto.gni")

source_set("unwind_core") {
  public_deps = [
    "../../../gn:bionic_kernel_uapi_headers",
    "../../base",
  ]
  deps = [ "../../../gn:default_deps" ]
  sources = [
    "asm_get_regs.h",
    "cpu_registers.cc",
    "cpu_registers.h",
    "perf_regs.h",
    "unwind_context.cc",
    "unwind_context.h",
    "unwind_types.h",
  ]
}

_use_libunwind = perfetto_unwinder_backend == "libunwind" && is_linux &&
                 !is_android && current_cpu == "x64"

group("unwind_backend") {
  if (_use_libunwind) {
    public_deps = [ "libunwind" ]
  } else {
    public_deps = [ "libunwindstack" ]
  }
}

group("unittests") {
  testonly = true
  if (_use_libunwind) {
    public_deps = [ "libunwind:unittests" ]
  } else {
    public_deps = [ "libunwindstack:unittests" ]
  }
}

if (enable_perfetto_benchmarks) {
  source_set("benchmarks") {
    testonly = true
    deps = [
      ":unwind_backend",
      ":unwind_core",
      "../../../gn:benchmark",
      "../../../gn:default_deps",
      "../../../src/base",
    ]
    sources = [ "unwind_benchmark.cc" ]
  }
}
