import("../../../gn/perfetto.gni")
import("../../../gn/test.gni")

# Header-only register types and local register capture. Kept free of compiled
# code so heapprofd_client can depend on it without pulling in the engine.
source_set("unwind_core") {
  public_deps = [ "../../base" ]
  deps = [ "../../../gn:default_deps" ]
  sources = [
    "cpu_registers.h",
    "get_asm_regs.h",
  ]
}

# Unwinding output types (frames, mappings, results). Daemon side only.
source_set("unwind_types") {
  deps = [ "../../../gn:default_deps" ]
  sources = [
    "unwind_types.cc",
    "unwind_types.h",
  ]
}

# Backend-agnostic unwinding interface. Daemon side only.
source_set("unwind_engine") {
  public_deps = [
    ":unwind_core",
    ":unwind_types",
    "../../base",
  ]
  deps = [ "../../../gn:default_deps" ]
  sources = [
    "unwind_engine.cc",
    "unwind_engine.h",
  ]
}

source_set("proc_pid_maps") {
  public_deps = [ "../../base" ]
  deps = [ "../../../gn:default_deps" ]
  sources = [ "proc_pid_maps.h" ]
}

_use_libunwind = perfetto_unwinder_backend == "libunwind" && is_linux &&
                 !is_android && current_cpu == "x64"

group("unwind_backend") {
  if (_use_libunwind) {
    public_deps = [ "libunwind" ]
  } else {
    public_deps = [ "libunwindstack" ]
  }
}

perfetto_unittest_source_set("unittests") {
  testonly = true
  deps = [
    ":proc_pid_maps",
    "../../../gn:default_deps",
    "../../../gn:gtest_and_gmock",
  ]
  if (_use_libunwind) {
    deps += [ "libunwind:unittests" ]
  } else {
    deps += [ "libunwindstack:unittests" ]
  }
  sources = [ "proc_pid_maps_unittest.cc" ]
}

if (enable_perfetto_benchmarks && enable_perfetto_traced_perf &&
    enable_perfetto_heapprofd) {
  source_set("benchmarks") {
    testonly = true
    deps = [
      ":unwind_backend",
      ":unwind_engine",
      "../../../gn:benchmark",
      "../../../gn:default_deps",
      "../../../src/base",
      "../perf:unwinding",
    ]
    sources = [ "unwind_benchmark.cc" ]
  }
}
