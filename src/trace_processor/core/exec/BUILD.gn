import("../../../../gn/test.gni")

source_set("exec") {
  sources = [
    "column_view.cc",
    "column_view.h",
    "operator.cc",
    "operator.h",
    "pipeline.cc",
    "pipeline.h",
    "row_batch.cc",
    "row_batch.h",
    "row_cursor.cc",
    "row_cursor.h",
    "row_selection.h",
    "row_store.cc",
    "row_store.h",
    "variant.h",
  ]
  deps = [
    "../../../../gn:default_deps",
    "../../../base",
    "../../containers",
    "../common",
    "../util",
  ]
}

source_set("test_utils") {
  testonly = true
  sources = [ "test_utils.h" ]
  deps = [ ":exec" ]
}

perfetto_unittest_source_set("unittests") {
  testonly = true
  sources = [
    "operator_unittest.cc",
    "row_batch_unittest.cc",
    "row_store_unittest.cc",
    "variant_unittest.cc",
  ]
  deps = [
    ":exec",
    ":test_utils",
    "../../../../gn:default_deps",
    "../../../../gn:gtest_and_gmock",
    "../../../base",
    "../../containers",
    "../common",
    "../util",
  ]
}
