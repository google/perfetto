import("../../../../gn/perfetto.gni")
import("../../../../gn/test.gni")

source_set("exec") {
  sources = [
    "assert_type.cc",
    "assert_type.h",
    "breaker.cc",
    "breaker.h",
    "column_chunk.h",
    "column_view.cc",
    "column_view.h",
    "dataframe_scan.cc",
    "dataframe_scan.h",
    "operator.cc",
    "operator.h",
    "pipeline.cc",
    "pipeline.h",
    "row_batch.cc",
    "row_batch.h",
    "row_cursor.cc",
    "row_cursor.h",
    "row_selection.h",
    "row_store.cc",
    "row_store.h",
    "tree_number_nodes.cc",
    "tree_number_nodes.h",
    "tree_order.cc",
    "tree_order.h",
    "variant.h",
  ]
  deps = [
    "../../../../gn:default_deps",
    "../../../base",
    "../../containers",
    "../common",
    "../dataframe",
    "../util",
  ]
}

source_set("test_utils") {
  testonly = true
  sources = [ "test_utils.h" ]
  deps = [
    ":exec",
    "../../../base",
    "../common",
  ]
}

perfetto_unittest_source_set("unittests") {
  testonly = true
  sources = [
    "assert_type_unittest.cc",
    "breaker_unittest.cc",
    "dataframe_scan_unittest.cc",
    "operator_unittest.cc",
    "row_batch_unittest.cc",
    "row_store_unittest.cc",
    "tree_number_nodes_unittest.cc",
    "tree_order_unittest.cc",
    "variant_unittest.cc",
  ]
  deps = [
    ":exec",
    ":test_utils",
    "../../../../gn:default_deps",
    "../../../../gn:gtest_and_gmock",
    "../../../base",
    "../../containers",
    "../common",
    "../dataframe",
    "../util",
  ]
}

if (enable_perfetto_benchmarks) {
  source_set("benchmarks") {
    testonly = true
    sources = [
      "tree_number_nodes_benchmark.cc",
      "tree_order_benchmark.cc",
    ]
    deps = [
      ":exec",
      "../../../../gn:benchmark",
      "../../../../gn:default_deps",
      "../../containers",
      "../common",
      "../dataframe",
    ]
  }
}
