node PerfettoArgDef {
  arg_name: index Name
  arg_type: inline SyntaqliteTextSpan
  is_variadic: inline Bool

  semantic { column_def(name: arg_name, type: arg_type) }

  fmt {
    child(arg_name) space span(arg_type)
    if_flag(is_variadic) { "..." }
  }
}

list PerfettoArgDefList {
  PerfettoArgDef
  fmt { for_each(sep: "," line) { child(_item) } }
}

node PerfettoMacroArg {
  arg_name: inline SyntaqliteTextSpan
  arg_type: inline SyntaqliteTextSpan

  fmt {
    span(arg_name) space span(arg_type)
  }
}

list PerfettoMacroArgList {
  PerfettoMacroArg
  fmt { for_each(sep: "," line) { child(_item) } }
}

node PerfettoIndexedColumn {
  column_name: inline SyntaqliteTextSpan

  fmt { span(column_name) }
}

list PerfettoIndexedColumnList {
  PerfettoIndexedColumn
  fmt { for_each(sep: "," line) { child(_item) } }
}

enum PerfettoReturnKind { SCALAR TABLE }

node PerfettoReturnType {
  kind: inline PerfettoReturnKind
  scalar_type: inline SyntaqliteTextSpan
  table_columns: index PerfettoArgDefList

  semantic { return_spec(table_columns: table_columns) }

  fmt {
    switch(kind) {
      SCALAR { span(scalar_type) }
      TABLE  {
        group {
          "TABLE("
          nest {
            softline
            child(table_columns)
          }
          softline ")"
        }
      }
    }
  }
}

node PerfettoTableImpl {
  name: inline SyntaqliteTextSpan

  fmt { span(name) }
}

node CreatePerfettoTableStmt {
  table_name: inline SyntaqliteTextSpan
  or_replace: inline Bool
  table_impl: index PerfettoTableImpl
  schema: index PerfettoArgDefList
  select: index Select
  select_span: inline SyntaqliteTextSpan

  semantic { define_table(name: table_name, columns: schema, select: select) }

  fmt {
    group {
      "CREATE"
      if_flag(or_replace) { space "OR" "REPLACE" }
      space "PERFETTO" "TABLE" space span(table_name)
      if_set(table_impl) {
        space "USING" space
        child(table_impl)
      }
      if_set(schema) {
        "("
        nest {
          softline
          child(schema)
        }
        softline ")"
      }
      if_set(select) { line "AS" }
    }
    if_set(select) { hardline child(select) }
  }
}

node CreatePerfettoViewStmt {
  view_name: inline SyntaqliteTextSpan
  or_replace: inline Bool
  schema: index PerfettoArgDefList
  select: index Select
  select_span: inline SyntaqliteTextSpan

  semantic { define_view(name: view_name, columns: schema, select: select) }

  fmt {
    group {
      "CREATE"
      if_flag(or_replace) { space "OR" "REPLACE" }
      space "PERFETTO" "VIEW" space span(view_name)
      if_set(schema) {
        "("
        nest {
          softline
          child(schema)
        }
        softline ")"
      }
      line "AS"
    }
    hardline child(select)
  }
}

node CreatePerfettoFunctionStmt {
  function_name: inline SyntaqliteTextSpan
  or_replace: inline Bool
  args: index PerfettoArgDefList
  return_type: index PerfettoReturnType
  select: index Select
  select_span: inline SyntaqliteTextSpan

  semantic { define_function(name: function_name, args: args, return_type: return_type, select: select) }

  fmt {
    group {
      "CREATE"
      if_flag(or_replace) { space "OR" "REPLACE" }
      space "PERFETTO" "FUNCTION" space span(function_name)
      "("
      if_set(args) {
        nest {
          softline
          child(args)
        }
        softline
      }
      ")"
    }
    hardline "RETURNS" space child(return_type)
    hardline "AS"
    hardline child(select)
  }
}

node CreatePerfettoDelegatingFunctionStmt {
  function_name: inline SyntaqliteTextSpan
  or_replace: inline Bool
  args: index PerfettoArgDefList
  return_type: index PerfettoReturnType
  delegate_to: inline SyntaqliteTextSpan

  fmt {
    group {
      "CREATE"
      if_flag(or_replace) { space "OR" "REPLACE" }
      space "PERFETTO" "FUNCTION" space span(function_name)
      "("
      if_set(args) {
        nest {
          softline
          child(args)
        }
        softline
      }
      ")"
    }
    hardline "RETURNS" space child(return_type)
    hardline "DELEGATES" "TO" space span(delegate_to)
  }
}

node CreatePerfettoIndexStmt {
  index_name: inline SyntaqliteTextSpan
  or_replace: inline Bool
  table_name: inline SyntaqliteTextSpan
  columns: index PerfettoIndexedColumnList

  fmt {
    group {
      "CREATE"
      if_flag(or_replace) { space "OR" "REPLACE" }
      space "PERFETTO" "INDEX" space span(index_name)
      space "ON" space span(table_name)
      "("
      nest {
        softline
        child(columns)
      }
      softline ")"
    }
  }
}

node CreatePerfettoMacroStmt {
  macro_name: inline SyntaqliteTextSpan
  or_replace: inline Bool
  return_type: inline SyntaqliteTextSpan
  body: inline SyntaqliteTextSpan
  args: index PerfettoMacroArgList

  macro_def(name: macro_name, body: body, args: args, arg_name: arg_name)

  fmt {
    group {
      "CREATE"
      if_flag(or_replace) { space "OR" "REPLACE" }
      space "PERFETTO" "MACRO" space span(macro_name)
      "("
      if_set(args) {
        nest {
          softline
          child(args)
        }
        softline
      }
      ")"
    }
    hardline "RETURNS" space span(return_type)
    hardline "AS" space span(body)
  }
}

node IncludePerfettoModuleStmt {
  module_name: inline SyntaqliteTextSpan

  semantic { import(module: module_name) }

  fmt {
    "INCLUDE" "PERFETTO" "MODULE" space span(module_name)
  }
}

node DropPerfettoIndexStmt {
  index_name: inline SyntaqliteTextSpan
  table_name: inline SyntaqliteTextSpan

  fmt {
    "DROP" "PERFETTO" "INDEX" space span(index_name) space "ON" space span(table_name)
  }
}

// `PERFETTO PRAGMA name = value`: a setting of the engine.
node PerfettoPragmaStmt {
  name: inline SyntaqliteTextSpan
  value: index Expr

  fmt { "PERFETTO" "PRAGMA" space span(name) space "=" space child(value) }
}

// ---------- Pipelines ----------

// What a pipeline starts from: a table, or a subquery in parentheses.
node PerfettoPipeSource {
  table_name: inline SyntaqliteTextSpan
  schema: inline SyntaqliteTextSpan
  select: index Select
  alias: index Name

  fmt {
    if_set(select) {
      group { "(" nest { softline child(select) } softline ")" }
    } else {
      if_span(schema) { span(schema) "." }
      span(table_name)
    }
    if_set(alias) { space "AS" space child(alias) }
  }
}

enum PerfettoTreeDirection { UP DOWN }

// One aggregate of a stage which computes them: `SUM(col) AS name`. Any
// expression parses; the compiler rejects the ones it cannot run.
node PerfettoAggregate {
  expr: index Expr
  name: inline SyntaqliteTextSpan

  fmt { child(expr) space "AS" space span(name) }
}

list PerfettoAggregateList {
  PerfettoAggregate
  fmt { for_each(sep: "," line) { child(_item) } }
}

// `TREE ACCUMULATE UP | DOWN agg AS name, ...`
node PerfettoTreeAccumulate {
  direction: inline PerfettoTreeDirection
  aggregates: index PerfettoAggregateList

  fmt {
    group {
      "TREE" "ACCUMULATE" space
      enum_display(direction, { UP="UP" DOWN="DOWN" })
      nest { line child(aggregates) }
    }
  }
}

// A column a stage names, as `column` or `alias.column`, optionally renamed.
node PerfettoPipeColumn {
  qualifier: inline SyntaqliteTextSpan
  name: inline SyntaqliteTextSpan
  alias: inline SyntaqliteTextSpan

  fmt {
    if_span(qualifier) { span(qualifier) "." }
    span(name)
    if_span(alias) { space "AS" space span(alias) }
  }
}

list PerfettoPipeColumnList {
  PerfettoPipeColumn
  fmt { for_each(sep: "," line) { child(_item) } }
}

enum PerfettoTreeFindDirection { ANCESTOR DESCENDANT }

// `[LEFT] TREE FIND rel AS alias NEAREST ANCESTOR | DESCENDANT [OR SELF] WHERE
// expr [ORDER BY ...]`. Without a keyword the join type is INNER. Any join type
// parses in LEFT's place and the compiler rejects the others. Only DESCENDANT
// parses with an ORDER BY.
node PerfettoTreeFind {
  join_type: inline JoinType
  operand: index PerfettoPipeSource
  direction: inline PerfettoTreeFindDirection
  or_self: inline Bool
  condition: index Expr
  order: index PerfettoPipeOrderTermList

  fmt {
    group {
      switch(join_type) {
        COMMA { }
        INNER { }
        LEFT { "LEFT" space }
        RIGHT { "RIGHT" space }
        FULL { "FULL" space }
        CROSS { "CROSS" space }
        NATURAL_INNER { "NATURAL" space }
        NATURAL_LEFT { "NATURAL" "LEFT" space }
        NATURAL_RIGHT { "NATURAL" "RIGHT" space }
        NATURAL_FULL { "NATURAL" "FULL" space }
        NATURAL_CROSS { "NATURAL" "CROSS" space }
      }
      "TREE" "FIND" space child(operand)
      nest {
        line "NEAREST" space
        enum_display(direction, {
          ANCESTOR="ANCESTOR"
          DESCENDANT="DESCENDANT"
        })
        if_flag(or_self) { space "OR" "SELF" }
        line "WHERE" space child(condition)
        if_set(order) { line "ORDER" "BY" space child(order) }
      }
    }
  }
}

enum PerfettoTreeFoldKind { CONTRACT ABSORB }

// `TREE CONTRACT | ABSORB AT rel AGGREGATE ...`
node PerfettoTreeFold {
  kind: inline PerfettoTreeFoldKind
  selection: index PerfettoPipeSource
  aggregates: index PerfettoAggregateList

  fmt {
    group {
      "TREE" space enum_display(kind, { CONTRACT="CONTRACT" ABSORB="ABSORB" })
      space "AT" space child(selection)
      nest { line "AGGREGATE" space child(aggregates) }
    }
  }
}

// `TREE PRUNE AT rel`
node PerfettoTreePrune {
  selection: index PerfettoPipeSource

  fmt { group { "TREE" "PRUNE" "AT" space child(selection) } }
}

// `TREE REPARENT TO NEAREST ANCESTOR IN rel`
node PerfettoTreeReparent {
  markers: index PerfettoPipeSource

  fmt {
    group {
      "TREE" "REPARENT" "TO" "NEAREST" "ANCESTOR" "IN" space child(markers)
    }
  }
}

// `TREE KEY PATHS BY col, ... AS (key, parent_key)`
node PerfettoTreeKeyPaths {
  columns: index PerfettoPipeColumnList
  key_name: inline SyntaqliteTextSpan
  parent_key_name: inline SyntaqliteTextSpan

  fmt {
    group {
      "TREE" "KEY" "PATHS" space "BY" nest { line child(columns) }
      line "AS" space "(" span(key_name) "," space span(parent_key_name) ")"
    }
  }
}

// `TREE MERGE [CONSECUTIVE] SIBLINGS BY col, ... AGGREGATE ...`
node PerfettoTreeMergeSiblings {
  consecutive: inline Bool
  columns: index PerfettoPipeColumnList
  aggregates: index PerfettoAggregateList

  fmt {
    group {
      "TREE" "MERGE"
      if_flag(consecutive) { space "CONSECUTIVE" }
      space "SIBLINGS" space "BY" nest { line child(columns) }
      nest { line "AGGREGATE" space child(aggregates) }
    }
  }
}

// `TREE MERGE INTO PARENT BY col, ... [INDIRECT] AGGREGATE ...`
node PerfettoTreeMergeIntoParent {
  columns: index PerfettoPipeColumnList
  indirect: inline Bool
  aggregates: index PerfettoAggregateList

  fmt {
    group {
      "TREE" "MERGE" "INTO" "PARENT" space "BY" nest { line child(columns) }
      if_flag(indirect) { space "INDIRECT" }
      nest { line "AGGREGATE" space child(aggregates) }
    }
  }
}

// `TREE INVERT`
node PerfettoTreeInvert {
  fmt { "TREE" "INVERT" }
}

enum PerfettoTreeChargeEnd { LEAF ROOT }

// `TREE EXPAND UP | DOWN rel BY col, ... [ORDER BY col, ...]
// [CHARGE col, ... TO LEAF | ROOT]`
node PerfettoTreeExpand {
  direction: inline PerfettoTreeDirection
  inserted: index PerfettoPipeSource
  keys: index PerfettoPipeColumnList
  order: index PerfettoPipeColumnList
  charge: index PerfettoPipeColumnList
  charge_end: inline PerfettoTreeChargeEnd

  fmt {
    group {
      "TREE" "EXPAND" space enum_display(direction, { UP="UP" DOWN="DOWN" })
      space child(inserted)
      nest {
        line "BY" space child(keys)
        if_set(order) { line "ORDER" "BY" space child(order) }
        if_set(charge) {
          line "CHARGE" space child(charge) space "TO" space
          enum_display(charge_end, { LEAF="LEAF" ROOT="ROOT" })
        }
      }
    }
  }
}

// A bare column name, as listed by DROP or a star's EXCEPT.
node PerfettoPipeName {
  name: inline SyntaqliteTextSpan

  fmt { span(name) }
}

list PerfettoPipeNameList {
  PerfettoPipeName
  fmt { for_each(sep: "," line) { child(_item) } }
}

// `*` or `alias.*`, optionally without some columns and with others replaced:
// `* EXCEPT (a, b) REPLACE (c AS d)`.
node PerfettoPipeStar {
  qualifier: inline SyntaqliteTextSpan
  except: index PerfettoPipeNameList
  replace: index PerfettoPipeColumnList

  fmt {
    if_span(qualifier) { span(qualifier) "." }
    "*"
    if_set(except) { space "EXCEPT" space "(" child(except) ")" }
    if_set(replace) { space "REPLACE" space "(" child(replace) ")" }
  }
}

// A column a SELECT or EXTEND lists: `expr [AS name]`. Only a column
// reference may go without a name.
node PerfettoPipeExprItem {
  expr: index Expr
  alias: inline SyntaqliteTextSpan

  fmt {
    child(expr)
    if_span(alias) { space "AS" space span(alias) }
  }
}

abstract PerfettoPipeSelectItem {
  PerfettoPipeExprItem
  PerfettoPipeStar
}

list PerfettoPipeSelectItemList {
  PerfettoPipeSelectItem
  fmt { for_each(sep: "," line) { child(_item) } }
}

// `SELECT item, ...`: picks, orders, renames and computes columns.
node PerfettoPipeSelect {
  columns: index PerfettoPipeSelectItemList

  fmt { group { "SELECT" nest { line child(columns) } } }
}

// `EXTEND item, ...`: adds columns to the row.
node PerfettoPipeExtend {
  columns: index PerfettoPipeSelectItemList

  fmt { group { "EXTEND" nest { line child(columns) } } }
}

// `DROP name, ...`: removes columns from the row.
node PerfettoPipeDrop {
  columns: index PerfettoPipeNameList

  fmt { group { "DROP" nest { line child(columns) } } }
}

// `RENAME old AS new, ...`
node PerfettoPipeRename {
  columns: index PerfettoPipeColumnList

  fmt { group { "RENAME" nest { line child(columns) } } }
}

// One assignment of a SET stage: `name = expr`.
node PerfettoPipeSetItem {
  name: inline SyntaqliteTextSpan
  value: index Expr

  fmt { span(name) space "=" space child(value) }
}

list PerfettoPipeSetItemList {
  PerfettoPipeSetItem
  fmt { for_each(sep: "," line) { child(_item) } }
}

// `SET name = expr, ...`: replaces the values of columns.
node PerfettoPipeSet {
  items: index PerfettoPipeSetItemList

  fmt { group { "SET" nest { line child(items) } } }
}

// `AS alias`: gives the whole row a new table alias.
node PerfettoPipeAs {
  alias: inline SyntaqliteTextSpan

  fmt { "AS" space span(alias) }
}

// One key of an ORDER BY stage: `expr [ASC | DESC]`.
node PerfettoPipeOrderTerm {
  expr: index Expr
  sort_order: inline SortOrder

  fmt {
    child(expr)
    switch(sort_order) {
      ASC { space "ASC" }
      DESC { space "DESC" }
    }
  }
}

list PerfettoPipeOrderTermList {
  PerfettoPipeOrderTerm
  fmt { for_each(sep: "," line) { child(_item) } }
}

// `ORDER BY expr [ASC | DESC], ...`: sorts the rows.
node PerfettoPipeOrderBy {
  terms: index PerfettoPipeOrderTermList

  fmt { group { "ORDER" "BY" nest { line child(terms) } } }
}

// `AGGREGATE agg AS name, ... [GROUP BY column, ...]`: collapses each group of
// rows agreeing on the columns into one row, or all rows without GROUP BY.
node PerfettoPipeAggregate {
  aggregates: index PerfettoAggregateList
  group_by: index PerfettoPipeColumnList

  fmt {
    group {
      "AGGREGATE"
      nest { line child(aggregates) }
      if_set(group_by) { line "GROUP" "BY" nest { line child(group_by) } }
    }
  }
}

// `WHERE condition`: keeps the rows the condition holds for.
node PerfettoPipeWhere {
  condition: index Expr

  fmt { group { "WHERE" nest { line child(condition) } } }
}

// `LIMIT count [OFFSET skipped]`: keeps `count` rows after skipping
// `skipped`.
node PerfettoPipeLimit {
  count: index Expr
  offset: index Expr

  fmt {
    group {
      "LIMIT" space child(count)
      if_set(offset) { space "OFFSET" space child(offset) }
    }
  }
}

// `[LEFT | RIGHT | FULL | ...] JOIN rel { ON expr | USING (cols) }`: joins
// the rows to another relation, as a SQL join does.
node PerfettoPipeJoin {
  join_type: inline JoinType
  operand: index PerfettoPipeSource
  on_expr: index Expr
  using_columns: index PerfettoPipeNameList

  fmt {
    group {
      switch(join_type) {
        COMMA { "," }
        INNER { "JOIN" }
        LEFT { "LEFT" "JOIN" }
        RIGHT { "RIGHT" "JOIN" }
        FULL { "FULL" "JOIN" }
        CROSS { "CROSS" "JOIN" }
        NATURAL_INNER { "NATURAL" "JOIN" }
        NATURAL_LEFT { "NATURAL" "LEFT" "JOIN" }
        NATURAL_RIGHT { "NATURAL" "RIGHT" "JOIN" }
        NATURAL_FULL { "NATURAL" "FULL" "JOIN" }
        NATURAL_CROSS { "NATURAL" "CROSS" "JOIN" }
      }
      space child(operand)
      if_set(on_expr) { nest { line "ON" space child(on_expr) } }
      if_set(using_columns) {
        space "USING" space "(" child(using_columns) ")"
      }
    }
  }
}

// `DISTINCT`: keeps one of each set of rows equal in every column.
node PerfettoPipeDistinct {
  fmt { "DISTINCT" }
}

abstract PerfettoPipeStage {
  PerfettoPipeWhere
  PerfettoPipeDistinct
  PerfettoPipeLimit
  PerfettoTreeAccumulate
  PerfettoTreeFind
  PerfettoTreeFold
  PerfettoTreePrune
  PerfettoTreeReparent
  PerfettoTreeKeyPaths
  PerfettoTreeMergeSiblings
  PerfettoTreeMergeIntoParent
  PerfettoTreeInvert
  PerfettoTreeExpand
  PerfettoIntervalFlatten
  PerfettoIntervalFillGaps
  PerfettoIntervalMerge
  PerfettoIntervalsFromEvents
  PerfettoPipeJoin
  PerfettoPipeOrderBy
  PerfettoPipeAggregate
  PerfettoPipeSelect
  PerfettoPipeExtend
  PerfettoPipeDrop
  PerfettoPipeRename
  PerfettoPipeSet
  PerfettoPipeAs
}

list PerfettoPipeStageList {
  PerfettoPipeStage
  fmt { for_each(sep: hardline "|>" space) { child(_item) } }
}

list PerfettoPipeSourceList {
  PerfettoPipeSource
  fmt { for_each(sep: "," line) { child(_item) } }
}

// A column named after PER, which confines an operator to each group of
// rows agreeing on it.
node PerfettoPerColumn {
  name: inline SyntaqliteTextSpan

  fmt { span(name) }
}

list PerfettoPerColumnList {
  PerfettoPerColumn
  fmt { for_each(sep: "," line) { child(_item) } }
}

// `INTERVAL FLATTEN [PER cols] AGGREGATE agg AS name, ...`: cuts overlapping
// rows at every boundary into disjoint segments, one row per segment.
node PerfettoIntervalFlatten {
  per: index PerfettoPerColumnList
  aggregates: index PerfettoAggregateList

  fmt {
    group {
      "INTERVAL" "FLATTEN"
      if_set(per) { space "PER" space child(per) }
      nest { line "AGGREGATE" space child(aggregates) }
    }
  }
}

// `INTERVAL FILL GAPS WITH rel [PER cols]`: lays the rows over a background,
// adding a row over each span of the background they do not cover.
node PerfettoIntervalFillGaps {
  background: index PerfettoPipeSource
  per: index PerfettoPerColumnList

  fmt {
    group {
      "INTERVAL" "FILL" "GAPS" "WITH" space child(background)
      if_set(per) { space "PER" space child(per) }
    }
  }
}

enum PerfettoIntervalMergeKind { OVERLAPPING CONSECUTIVE }

// `INTERVAL MERGE OVERLAPPING [PER cols] AGGREGATE ...` coalesces overlapping
// and abutting rows. `INTERVAL MERGE CONSECUTIVE BY keys [PER cols]
// AGGREGATE ...` merges only adjacent rows agreeing on the keys.
node PerfettoIntervalMerge {
  kind: inline PerfettoIntervalMergeKind
  keys: index PerfettoPerColumnList
  per: index PerfettoPerColumnList
  aggregates: index PerfettoAggregateList

  fmt {
    group {
      "INTERVAL" "MERGE" space
      enum_display(kind, {
        OVERLAPPING="OVERLAPPING"
        CONSECUTIVE="CONSECUTIVE"
      })
      if_set(keys) { space "BY" space child(keys) }
      if_set(per) { space "PER" space child(per) }
      nest { line "AGGREGATE" space child(aggregates) }
    }
  }
}

enum PerfettoEventsLast { KEEP_OPEN CLOSE_AT }

// `INTERVALS FROM EVENTS [PER cols] [STOP rel] { KEEPING LAST OPEN |
// CLOSING LAST AT (expr) }`: turns each row into an interval ending at the
// next row in its lane, or at the next STOP event.
node PerfettoIntervalsFromEvents {
  per: index PerfettoPerColumnList
  stop: index PerfettoPipeSource
  last: inline PerfettoEventsLast
  close_at: index Expr

  fmt {
    group {
      "INTERVALS" "FROM" "EVENTS"
      if_set(per) { space "PER" space child(per) }
      if_set(stop) { nest { line "STOP" space child(stop) } }
      switch(last) {
        KEEP_OPEN { nest { line "KEEPING" "LAST" "OPEN" } }
        CLOSE_AT {
          nest { line "CLOSING" "LAST" "AT" space "(" child(close_at) ")" }
        }
      }
    }
  }
}

// `INTERVAL INTERSECTION OF (rel AS a, rel AS b, ...) [PER cols]`: the
// regions every operand covers, one row per region carrying all of their
// columns.
node PerfettoIntervalIntersection {
  operands: index PerfettoPipeSourceList
  per: index PerfettoPerColumnList

  fmt {
    group {
      "INTERVAL" "INTERSECTION" "OF" space "("
      nest { softline child(operands) }
      softline ")"
    }
    if_set(per) { space "PER" space child(per) }
  }
}

enum PerfettoGraphTreeKind { BFS DFS DOMINATOR }

// `GRAPH BFS | DFS | DOMINATOR TREE NODES rel EDGES rel FROM rel`: reduces the
// graph to a tree over the nodes reachable from the seeds in FROM.
node PerfettoGraphTree {
  kind: inline PerfettoGraphTreeKind
  nodes: index PerfettoPipeSource
  edges: index PerfettoPipeSource
  seeds: index PerfettoPipeSource

  fmt {
    group {
      "GRAPH" space
      enum_display(kind, { BFS="BFS" DFS="DFS" DOMINATOR="DOMINATOR" })
      space "TREE"
      nest {
        line "NODES" space child(nodes)
        line "EDGES" space child(edges)
        line "FROM" space child(seeds)
      }
    }
  }
}

// A pipeline: a source followed by `|>` stages. Exactly one of `from`,
// `intersection` and `graph` names the source.
node PerfettoPipeline {
  from: index PerfettoPipeSource
  intersection: index PerfettoIntervalIntersection
  graph: index PerfettoGraphTree
  stages: index PerfettoPipeStageList

  fmt {
    if_set(from) { "FROM" space child(from) }
    if_set(intersection) { child(intersection) }
    if_set(graph) { child(graph) }
    if_set(stages) { hardline "|>" space child(stages) }
  }
}
