import("../../../gn/test.gni")

source_set("analysis") {
  sources = [
    "program.cc",
    "program.h",
    "relation.cc",
    "relation.h",
    "source_tree.cc",
    "source_tree.h",
    "string_arena.h",
  ]
  deps = [
    "..:intrinsic_macro_expansion",
    "../../../gn:default_deps",
    "../../base",
    "../syntaqlite",
  ]
  assert_no_deps = [ "../../trace_processor/*" ]
}

perfetto_unittest_source_set("unittests") {
  testonly = true
  sources = [
    "program_unittest.cc",
    "relation_unittest.cc",
    "source_tree_unittest.cc",
  ]
  deps = [
    ":analysis",
    "../../../gn:default_deps",
    "../../../gn:gtest_and_gmock",
    "../../../include/perfetto/ext/base",
    "../../base:test_support",
    "../syntaqlite",
  ]
}
