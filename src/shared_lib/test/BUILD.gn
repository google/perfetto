import("../../../gn/perfetto.gni")

source_set("utils") {
  testonly = true
  deps = [
    "..:shared_lib",
    "../../../gn:default_deps",
    "../../../gn:gtest_and_gmock",
    "../../../include/perfetto/public",
  ]
  sources = [
    "utils.cc",
    "utils.h",
  ]
}

if (enable_perfetto_benchmarks) {
  source_set("benchmarks") {
    testonly = true
    deps = [
      ":multi_session_benchmark",
      ":utils",
      "..:shared_lib",
      "../../../gn:benchmark",
      "../../../gn:default_deps",
      "../../../include/perfetto/public",
    ]
    sources = [ "benchmark.cc" ]
  }

  # Uses an in-process service with distinct consumer UIDs so eight sessions
  # can run in one process without hitting the per-UID session limit.
  source_set("multi_session_benchmark") {
    testonly = true
    deps = [
      ":utils",
      "..:shared_lib",
      "../../../gn:benchmark",
      "../../../gn:default_deps",
      "../../../include/perfetto/base",
      "../../../include/perfetto/ext/tracing/core",
      "../../../include/perfetto/public",
      "../../../include/perfetto/tracing",
      "../../../protos/perfetto/config:cpp",
      "../../../protos/perfetto/config/track_event:cpp",
      "../../tracing:client_api",
      "../../tracing/core",
      "../../tracing/service",
    ]
    sources = [ "multi_session_benchmark.cc" ]
  }
}

if (enable_perfetto_integration_tests) {
  source_set("integrationtests") {
    testonly = true
    deps = [
      ":utils",
      "..:for_testing",
      "..:shared_lib",
      "../../../gn:default_deps",
      "../../../gn:gtest_and_gmock",
      "../../../include/perfetto/public",
      "../../../include/perfetto/tracing",
      "../../../include/perfetto/tracing/core",
      "../../base",
      "../../tracing/test:api_test_support",
      "protos",
    ]
    sources = [ "api_integrationtest.cc" ]
  }
}
