import("../../../gn/fuzzer.gni")
import("../../../gn/test.gni")

# The permanent tracing v2 protocol: the shared ring buffer and its ABI, the
# writer half of the chunk protocol, the single-consumer reader, and the proto-group
# encoding used between TraceWriterV2 and ProtoRewriter. See
# https://github.com/google/perfetto/discussions/7120 (RFC 0046) and
# https://github.com/google/perfetto/discussions/4508 (RFC 0014) for the design.
source_set("v2") {
  public_deps = [
    "../../../include/perfetto/ext/base",
    "../../../include/perfetto/ext/tracing/core",
    "../../../include/perfetto/protozero",
    "../../../include/perfetto/tracing",

    # trace_writer_v2.h holds a protozero RootMessage and a stream writer.
    "../../protozero",
  ]
  deps = [
    "../../../gn:default_deps",
    "../../../protos/perfetto/trace:zero",
    "../../base",
  ]
  sources = [
    "proto_rewriter.cc",
    "proto_rewriter.h",
    "shared_ring_buffer.cc",
    "shared_ring_buffer.h",
    "shared_ring_buffer_abi.h",
    "shared_ring_buffer_reader.cc",
    "shared_ring_buffer_reader.h",
    "shared_ring_buffer_writer.cc",
    "shared_ring_buffer_writer.h",
    "trace_writer_v2.cc",
    "trace_writer_v2.h",
  ]
}

# Temporary SDK-side forwarding through v1 until traced reads the ring buffer.
source_set("in_process_adapter") {
  public_deps = [ ":v2" ]
  deps = [
    "../../../gn:default_deps",
    "../../../protos/perfetto/trace:zero",
    "../../base",
  ]
  sources = [
    "in_process_tracing_v2_bridge.cc",
    "in_process_tracing_v2_bridge.h",
    "relay_sequence.h",
  ]
}

perfetto_unittest_source_set("in_process_adapter_unittests") {
  testonly = true
  deps = [
    ":in_process_adapter",
    "../../../gn:default_deps",
    "../../../gn:gtest_and_gmock",
    "../../../protos/perfetto/trace:cpp",
    "../../../protos/perfetto/trace:zero",
    "../../base",
    "../../base:test_support",
    "../../protozero",
  ]
  sources = [
    "in_process_tracing_v2_bridge_unittest.cc",
    "shared_ring_buffer_test_utils.h",
  ]
}

perfetto_unittest_source_set("unittests") {
  testonly = true
  deps = [
    ":v2",
    "../../../gn:default_deps",
    "../../../gn:gtest_and_gmock",
    "../../../protos/perfetto/trace:cpp",
    "../../../protos/perfetto/trace:zero",
    "../../base",
    "../../base:test_support",
    "../../protozero",
  ]
  sources = [
    "proto_rewriter_unittest.cc",
    "shared_ring_buffer_abi_unittest.cc",
    "shared_ring_buffer_concurrency_unittest.cc",
    "shared_ring_buffer_reader_unittest.cc",
    "shared_ring_buffer_test_utils.h",
    "shared_ring_buffer_unittest.cc",
    "shared_ring_buffer_writer_unittest.cc",
    "trace_writer_v2_unittest.cc",
  ]
}

perfetto_fuzzer_test("proto_rewriter_fuzzer") {
  sources = [ "proto_rewriter_fuzzer.cc" ]
  deps = [
    ":v2",
    "../../../gn:default_deps",
  ]
}
